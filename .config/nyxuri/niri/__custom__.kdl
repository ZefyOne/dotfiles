// Nyxuri Custom Configuration
//
// Any modification in this file — or any file you drop next to the shipped
// ones — is preserved across updates. Updates never overwrite your changes:
// they are kept and reported, and `nyxuri update --force` adopts the
// template side when you reviewed them.
//
// 任何在此文件中的修改——以及你放在配置目录里的任何自建文件——都会在系统
// 更新时被安全保留。更新永不覆盖你的改动：它们会被保留并在报告中列明；
// 确认过后可用 `nyxuri update --force` 采纳模板版。
//
// Personal autostart / window rules / 个人自启动与窗口规则：
//
// spawn-at-startup "fcitx5" "-d"
// spawn-at-startup "easyeffects" "--gapplication-service"
//
// window-rule {
//     match app-id="my-custom-app"
//     open-floating true
// }
//
// Custom key bindings / 自定义快捷键：
//
// This file loads AFTER binds.kdl, so binds here OVERRIDE template binds
// (niri include is positional; later binds win). Keep big keymap rewrites
// in their own file and include it from here — included files are watched
// and preserved the same way:
//
// 本文件在 binds.kdl 之后加载，这里的键位会覆盖模板键位（niri 的 include
// 是位置性的，后者胜出）。整套键位改写建议单独放一个文件并在此 include，
// 被包含文件享受同样的更新保护：
//
// include "my-binds__custom__.kdl"
// binds {
//     Mod+T { spawn "kitty"; }   // overrides the template bind / 覆盖模板键位
// }
//
// Note: niri can only OVERRIDE a bound key, not unbind it — to neutralize a
// template bind, rebind that key here to the action you prefer.
// 注意：niri 只能覆盖键位、不能解绑——想取消模板按键，在这里把它重新绑定
// 为你想要的动作即可。

// ============================================================================
// 个人键位 / Personal key bindings
// ============================================================================

binds {
    // Alt+Space 呼出/收起 Vicinae 启动器 / toggle launcher
    Alt+Space hotkey-overlay-title="Vicinae 启动器" { spawn "vicinae" "toggle"; }

    Alt+Q hotkey-overlay-title="关闭窗口" { close-window; }
    Mod+Q hotkey-overlay-title="Mod+Q（已禁用）" { spawn "true"; }

    // 焦点移动 / Focus movement
    Alt+H hotkey-overlay-title="焦点左移" { focus-column-left; }
    Alt+L hotkey-overlay-title="焦点右移" { focus-column-right; }
    Alt+J hotkey-overlay-title="焦点下移" { focus-window-or-workspace-down; }
    Alt+K hotkey-overlay-title="焦点上移" { focus-window-or-workspace-up; }

    // 终端 / Terminal
    Alt+Return hotkey-overlay-title="终端 kitty" { spawn "kitty"; }

    // 移动列 / 窗口 / Move column or window
    Alt+Ctrl+H hotkey-overlay-title="窗口左移" { move-column-left-or-to-monitor-left; }
    Alt+Ctrl+L hotkey-overlay-title="窗口右移" { move-column-right-or-to-monitor-right; }
    Alt+Ctrl+J hotkey-overlay-title="窗口下移" { move-window-down-or-to-workspace-down; }
    Alt+Ctrl+K hotkey-overlay-title="窗口上移" { move-window-up-or-to-workspace-up; }

    // 最大化当前列宽度 / Maximize column width
    Alt+F hotkey-overlay-title="最大化列宽" { maximize-column; }
}
