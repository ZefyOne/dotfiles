{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
 "logo": {
  "height": 5,
  "width": 10,
  "padding": {
    "top": 1
    }
  },
    "display": {
        "separator": " -> "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "keyWidth": 10,
			"format": "         {6}{7}{8}"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "#f5d76e"
        },
        {
            "type": "command",
            "key": " ",
            "keyColor": "#87c7ff",
            "text": "echo JaKooLit Version: ${DOTS_VERSION}"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#f08cf0"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#f5d76e"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#87c7ff"
        },
        /*
        {
            "type": "packages",
            "key": "󰏖 ",
            "keyColor": "#f5d76e"
        },
        */
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "#f08cf0",
            // format: used / total
            "format": "{1} / {2}"
        },
        {
            "type": "uptime",
            "key": "󰔛 ",
            "keyColor": "#8dff8d"
        },
        {
            "type": "command",
            "key": "󱦟 ",
            "keyColor": "#f08cf0",
            "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
        },
        {
            "type": "custom",
            "format": " ─────────────────────────── "
        },
        {
            "type": "custom",
            "format": "   \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[90m "
        },
		"break"
    ]
}
